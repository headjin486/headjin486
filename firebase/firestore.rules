rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }

    // Only revealed 5 m grid-cell identifiers are stored. Never store raw GPS tracks.
    match /exploration_backups/{uid}/chunks/{chunkId} {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['formatVersion', 'payload', 'updatedAt'])
        && request.resource.data.keys().hasAll(['formatVersion', 'payload', 'updatedAt'])
        && request.resource.data.formatVersion is int
        && request.resource.data.formatVersion == 1
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 700000
        && request.resource.data.updatedAt is timestamp;
    }
  }
}
